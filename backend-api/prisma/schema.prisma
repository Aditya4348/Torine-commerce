// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// 1. KATEGORI PRODUK
// ==========================================
model Category {
  id            String  @id @db.VarChar(50)
  name          String  @db.VarChar(100)
  icon_name     String  @default("LayoutGrid") @db.VarChar(50)
  display_order Int     @default(0)
  is_active     Boolean @default(true)

  products Product[]

  @@map("categories")
}

// ==========================================
// 2. MASTER PRODUK
// ==========================================
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  sku         String   @unique @db.VarChar(50)
  category_id String   @db.VarChar(50)
  name        String   @db.VarChar(255)
  summary     String?  @db.VarChar(500)
  description String?  @db.Text
  base_price  Decimal  @db.Decimal(12, 2)
  sale_price  Decimal  @db.Decimal(12, 2)
  is_in_stock Boolean  @default(true)
  is_popular  Boolean  @default(false)
  is_new      Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz
  updated_at  DateTime @updatedAt @db.Timestamptz

  category       Category               @relation(fields: [category_id], references: [id], onUpdate: Cascade, onDelete: Restrict)
  images         ProductImage[]
  variants       ProductVariant[]
  specifications ProductSpecification[]
  order_items    OrderItem[]

  @@index([category_id], map: "idx_products_category")
  @@index([sale_price], map: "idx_products_sale_price")
  @@index([category_id, sale_price, is_in_stock], map: "idx_products_filter")
  @@map("products")
}

// ==========================================
// 3. GALERI GAMBAR PRODUK
// ==========================================
model ProductImage {
  id            String  @id @default(uuid()) @db.Uuid
  product_id    String  @db.Uuid
  image_url     String  @db.Text
  display_order Int     @default(0)
  is_primary    Boolean @default(false)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_images")
}

// ==========================================
// 4. VARIAN PRODUK (WARNA & UKURAN)
// ==========================================
model ProductVariant {
  id             String  @id @default(uuid()) @db.Uuid
  product_id     String  @db.Uuid
  color_name     String? @db.VarChar(50)
  color_hex      String? @db.VarChar(10)
  size_label     String? @db.VarChar(20)
  sku_variant    String? @unique @db.VarChar(70)
  stock_quantity Int     @default(0)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_variants")
}

// ==========================================
// 5. SPESIFIKASI TEKNIS PRODUK
// ==========================================
model ProductSpecification {
  id            String @id @default(uuid()) @db.Uuid
  product_id    String @db.Uuid
  spec_label    String @db.VarChar(100)
  spec_value    String @db.Text
  display_order Int    @default(0)

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@map("product_specifications")
}

// ==========================================
// 6. MASTER TRANSAKSI / PESANAN (GUEST CHECKOUT)
// ==========================================
model Order {
  id               String   @id @db.VarChar(32) // Format: TRN-YYYYMMDD-XXXXX
  customer_name    String   @db.VarChar(150)
  customer_phone   String   @db.VarChar(30)
  customer_email   String?  @db.VarChar(150)
  shipping_address String   @db.Text
  subtotal         Decimal  @db.Decimal(12, 2)
  shipping_fee     Decimal  @default(0.00) @db.Decimal(12, 2)
  total_amount     Decimal  @db.Decimal(12, 2)
  status           String   @default("pending") @db.VarChar(30)
  tracking_number  String?  @db.VarChar(100)
  payment_method   String?  @db.VarChar(50)
  created_at       DateTime @default(now()) @db.Timestamptz

  items OrderItem[]

  @@map("orders")
}

// ==========================================
// 7. ITEM RINCIAN PESANAN (HISTORICAL SNAPSHOT)
// ==========================================
model OrderItem {
  id                String  @id @default(uuid()) @db.Uuid
  order_id          String  @db.VarChar(32)
  product_id        String? @db.Uuid
  product_name      String  @db.VarChar(255)
  price_at_purchase Decimal @db.Decimal(12, 2)
  selected_variant  String? @db.VarChar(100)
  quantity          Int     @default(1)
  subtotal          Decimal @db.Decimal(12, 2)

  order   Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([order_id], map: "idx_order_items_order")
  @@index([product_id])
  @@map("order_items")
}

// ==========================================
// 8. SESI AI CHAT CONCIERGE
// ==========================================
model AiChatSession {
  id            String   @id @default(uuid()) @db.Uuid
  started_at    DateTime @default(now()) @db.Timestamptz
  last_activity DateTime @default(now()) @updatedAt @db.Timestamptz

  messages AiChatMessage[]

  @@map("ai_chat_sessions")
}

// ==========================================
// 9. PESAN AI CHAT CONCIERGE
// ==========================================
model AiChatMessage {
  id                   String   @id @default(uuid()) @db.Uuid
  session_id           String   @db.Uuid
  sender               String   @db.VarChar(20) // 'user' atau 'assistant'
  message_text         String   @db.Text
  recommended_products Json?
  created_at           DateTime @default(now()) @db.Timestamptz

  session AiChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id], map: "idx_chat_messages_session")
  @@map("ai_chat_messages")
}
